[Unit]
Description=Melacs SEAS dashboard
After=network-online.target melacs-net.service
Wants=network-online.target
Requires=melacs-net.service

[Service]
Type=simple
WorkingDirectory=/opt/melacs-dashboard
Environment=MELACS_HOST=192.168.1.160
Environment=MELACS_PORT=502
Environment=MELACS_WEB_HOST=0.0.0.0
Environment=MELACS_WEB_PORT=80
ExecStart=/usr/bin/node /opt/melacs-dashboard/server/serve.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
