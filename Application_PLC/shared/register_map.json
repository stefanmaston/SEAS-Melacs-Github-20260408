    { "name": "pid1_ki", "modbus": 325, "type": "int16", "space": "holding", "comment": "Q8.8 per sekund." },
    { "name": "pid1_kd", "modbus": 326, "type": "int16", "space": "holding", "comment": "Q8.8 sekunder, derivata på mätvärdet." },
    { "name": "pid1_period_ms", "modbus": 327, "type": "uint16", "space": "holding", "comment": "1–1000 ms, 0 betyder 10." },
    { "name": "pid1_out_min", "modbus": 328, "type": "uint16", "space": "holding", "comment": "Lägsta utsignal, 0–65535." },
