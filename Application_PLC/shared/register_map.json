    { "name": "ilk1_cfg", "modbus": 302, "type": "uint16", "space": "holding", "comment": "bit0–1 DIO-ingång 0–3, bit2 1=löser på hög nivå, bit3 spärrar H1, bit4 spärrar H2, bit15 aktiv." },
